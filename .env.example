APP_NAME=rag-demo
APP_ENV=local
LOG_LEVEL=INFO

# MySQL: business metadata and task state.
MYSQL_HOST=localhost
MYSQL_PORT=13306
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag_password
MYSQL_DATABASE=rag_demo

# Elasticsearch: Chunk text, embedding and retrieval only.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=rag_demo_chunks_v1

# MinIO: source files and parser artifacts.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_FILES_BUCKET=rag-demo-files
MINIO_ARTIFACTS_BUCKET=rag-demo-artifacts

# RabbitMQ: asynchronous Task dispatch.
RABBITMQ_URL=amqp://rag_user:rag_password@localhost:5672/
RABBITMQ_EXCHANGE=rag_demo.tasks
RABBITMQ_ROUTING_KEY=task.execute
RABBITMQ_QUEUE=rag_demo.task.execute
RABBITMQ_DLX=rag_demo.dlx
RABBITMQ_DEAD_QUEUE=rag_demo.task.dead

# Chat uses an isolated topology so RAG task messages cannot cross-consume.
CHAT_RABBITMQ_EXCHANGE=rag_demo.chat.runs
CHAT_RABBITMQ_ROUTING_KEY=chat.run.execute
CHAT_RABBITMQ_QUEUE=rag_demo.chat.run.execute
CHAT_RABBITMQ_DLX=rag_demo.chat.dlx
CHAT_RABBITMQ_DEAD_QUEUE=rag_demo.chat.dead
CHAT_OUTBOX_LOCK_SECONDS=30
CHAT_OUTBOX_MAX_ATTEMPTS=10
CHAT_LEASE_SECONDS=60
CHAT_WORKER_PREFETCH_COUNT=1
CHAT_WORKER_CONCURRENCY=1
CHAT_HEARTBEAT_INTERVAL_SECONDS=15
CHAT_EXECUTION_TIMEOUT_SECONDS=300
CHAT_QUEUED_TIMEOUT_SECONDS=120
CHAT_RECOVERY_INTERVAL_SECONDS=10
CHAT_MAX_RECOVERY_COUNT=3
CHAT_EVENT_RETENTION_SECONDS=604800
CHAT_EVENT_POLL_INTERVAL_SECONDS=0.25
CHAT_EVENT_BATCH_CHARS=320
CHAT_EVENT_BATCH_INTERVAL_SECONDS=0.2
CHAT_RUN_BACKGROUND_SERVICES=true
CHAT_REQUIRE_CHECKPOINT=true

# PostgreSQL: LangGraph checkpoint state only; business data remains in MySQL.
CHECKPOINT_POSTGRES_URL=postgresql://checkpoint_user:checkpoint_password@localhost:15432/checkpoint_db
LANGGRAPH_STRICT_MSGPACK=true

# Model providers.
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-5-turbo
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSION=2048
EMBEDDING_BATCH_SIZE=16
MODEL_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512

GPT_BASE_URL=https://api.openai.com/v1
GPT_API_KEY=
GPT_MODEL=gpt-4o-mini
GPT_EMBEDDING_MODEL=text-embedding-3-small
GPT_EMBEDDING_DIMENSION=1536

# Parser, chunking and task controls.
MINERU_COMMAND=mineru
MINERU_TIMEOUT_SECONDS=120
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
CHUNKING_MAX_FILE_BYTES=52428800
CHUNKING_MAX_TOKENS=8192
CHUNKING_DEFAULT_SIZE=500
CHUNKING_DEFAULT_OVERLAP=80
TASK_MAX_RETRY=3
TASK_PAGE_SIZE=10
FAILED_GENERATION_TTL_SECONDS=86400
RUN_BACKGROUND_SERVICES=true
